# Port (must be 3000 in AI Studio environment)
PORT=3000

# PostgreSQL Database Connection String (Prisma)
# Example: postgresql://postgres:password@localhost:5432/polaris?schema=public
DATABASE_URL=

# Frontend allowed URL for CORS (or * for local dev)
FRONTEND_URL=*

# MQTT Broker Configuration (Provisional default: mqtt://broker.emqx.io or test.mosquitto.org)
MQTT_BROKER_URL=mqtt://broker.emqx.io:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=polaris-backend-m5

# Provisional MQTT Topic Prefix
# Telemetry pattern: polaris/device/{deviceId}/telemetry
MQTT_TOPIC_PREFIX=polaris/device

# ESP32 Security & Ingestion Token
ESP32_API_KEY=polaris_esp32_dev_secret_key_2026

# Configurable Alert Thresholds
# NOTE: Configurable pending official scientific M1-M3 calibration specs
LOW_BATTERY_THRESHOLD=20.0
TEMPERATURE_MIN=2.0
TEMPERATURE_MAX=35.0
DEPTH_MIN=0.0
DEPTH_MAX=100.0
SALINITY_MIN=30.0
SALINITY_MAX=40.0

# Device Offline Timeout in seconds (default: 60s)
DEVICE_OFFLINE_TIMEOUT=60

# Data Source Mode: 'hardware' | 'mock'
DATA_SOURCE=mock

# GEMINI_API_KEY (optional platform capability)
GEMINI_API_KEY=
APP_URL=
